<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (used on every supported device — minSdk 29 ≥ API 26). White background
  (matches the logo's own white) + the logo inset into the safe zone. The launcher masks this to
  its own shape (circle / squircle / rounded square), so it looks native everywhere.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_app_foreground" />
</adaptive-icon>
