# Release signing credentials for Smart Gallery.
#
# SETUP (one time):
#   1. Generate a keystore at the PROJECT ROOT (keep it safe & backed up — losing it means you can
#      never ship an update to an already-installed app):
#
#        keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 \
#                -validity 10000 -alias smartgallery
#
#   2. Copy this file to "keystore.properties" (same folder) and fill in the real values below.
#   3. keystore.properties and *.jks are gitignored — never commit them.
#
# If keystore.properties is absent, the release build automatically falls back to debug signing
# (see app/build.gradle.kts), so the project still builds — it just isn't shippable until this exists.

# Path to the keystore, relative to the project root.
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=smartgallery
keyPassword=CHANGE_ME
